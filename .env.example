# 複製成 .env 後再填值。.env 絕對不可以 commit。

# 地端模型（Ollama 裝在電腦上，不在 Docker 裡）
OLLAMA_URL=http://host.docker.internal:11434
# 3B 以下皆可；電腦較弱建議 qwen2.5:1.5b
LOCAL_MODEL=qwen2.5:3b

# 雲端 API 的 key（用哪一家自己決定，變數名稱也可以改）
CLOUD_API_KEY=

# RAG 版本：A＝固定長度切塊＋向量檢索；B＝依段落切塊＋混合檢索（BM25＋向量）
RAG_VERSION=B
# 嵌入模型（需先執行 ollama pull bge-m3）
EMBED_MODEL=bge-m3
# 檢索取前幾個切塊
TOP_K=3
